{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intensive English agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "objective", "base_ref", "authoritative_inputs", "allowed_paths",
    "forbidden_paths", "deliverables", "acceptance", "human_gates"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^IE-[0-9]{3,}$" },
    "objective": { "type": "string", "minLength": 10 },
    "base_ref": { "type": "string", "minLength": 1 },
    "authoritative_inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "human_gates": { "type": "array", "items": { "type": "string" } },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_workers": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_review_cycles": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}
