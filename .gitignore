# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm workspaces hoist to the repo-root node_modules)
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (ignored anywhere — now live under apps/*)
coverage
playwright-report/
test-results/

# next.js (ignored anywhere — now under apps/web)
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# Obsidian personal workspace/cache (portable vault settings remain tracked)
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/appearance.json

# Local source deliveries and meeting recordings (accepted artifacts are
# extracted into docs/ before commit; raw downloads stay outside the repo)
/Intensive English *zip*
/GMT*_Recording*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev auth store (file db) — now under apps/web
.data/
.data/pg
